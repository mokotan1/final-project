display_set_gui_size(1280, 720);
lang_init(); lang_font_init();
audio_volume_init();
menu_hover_endless = false;
menu_hover_classic = false;
menu_hover_start = false;
menu_hover_settings = false;
menu_hover_quit = false;
menu_hover_play = false;
menu_view = 0;
menu_settings_open = false;
menu_settings_dragging = false;
menu_selected_mode = GAME_MODE_ENDLESS;
menu_input_lock = room_speed / 3;
if (!variable_global_exists("audio_enabled")) global.audio_enabled = true;
global.game_mode = GAME_MODE_ENDLESS;
menu_best_endless = game_mode_load_best_score();
global.game_mode = GAME_MODE_CLASSIC;
menu_best_classic = game_mode_load_best_score();
global.game_mode = GAME_MODE_ENDLESS;
